# NocoDB must be reachable from the server running this app.
# A Tailscale IP (100.x.y.z) or MagicDNS hostname is supported.
NOCODB_BASE_URL=http://100.69.99.115:8080/

# Use the table ID, not the display name.
NOCODB_TABLE_ID=your-table-id

# Keep this server-side. Never prefix it with VITE_.
NOCODB_API_TOKEN=your-nocodb-api-token
